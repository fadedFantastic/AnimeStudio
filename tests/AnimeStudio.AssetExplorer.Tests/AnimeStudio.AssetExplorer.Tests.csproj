<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\AnimeStudio.AssetExplorer\AnimeStudio.AssetExplorer.csproj" />
    <Content Include="..\..\AnimeStudio.Libraries\x64\*.dll" Link="x64\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\AnimeStudio.Libraries\x86\*.dll" Link="x86\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
